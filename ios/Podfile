# Resolve react_native_pods.rb with node
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve("react-native/scripts/react_native_pods.rb", {paths: [process.argv[1]]})',
  __dir__]).strip

platform :ios, '15.1'  # ✅ Match project requirement

prepare_react_native_project!

# ✅ Fix Firebase + Swift static library issues
use_modular_headers!
use_frameworks! :linkage => :static   # ✅ Required for Firebase + Swift pods

target 'LetsMeet' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :fabric_enabled => false,
    :hermes_enabled => false
  )

  # ✅ Dependencies
  pod 'lottie-react-native', :path => '../node_modules/lottie-react-native'
  pod 'Firebase/Core'
  pod 'Firebase/Messaging'

  # ✅ Ensure every pod respects iOS 15.1
  pre_install do |installer|
    Pod::UI.puts "🔧 Forcing iOS 15.1 for all pods..."
    installer.pod_targets.each do |pod|
      if pod.respond_to?(:deployment_target=)
        pod.deployment_target = '15.1'
      end
    end
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # ✅ Force iOS version
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        # ✅ Allow non-modular includes (fixes UIKit / VisionCamera issues)
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end
  end
end
