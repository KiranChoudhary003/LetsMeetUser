<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Prevent system dark mode from overriding your style -->
        <item name="android:forceDarkAllowed">false</item>

        <!-- Set your desired status bar color -->
        <item name="android:statusBarColor">#34495e</item>

        <!-- Force white status bar icons (for dark background) -->
        <item name="android:windowLightStatusBar">false</item>

        <!-- Optional: Keep your existing edit text background -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    </style>
</resources>
